# Required to manage letters at /admin.
ADMIN_PASSWORD=change-me

# Public address of the site. Used in emailed links; https enables secure cookies.
SITE_URL=http://localhost:3000
SITE_NAME=Countersign

# Postgres connection string. Leave unset to use an embedded database in ./.data
# (fine for development and small single-server installs).
# DATABASE_URL=postgres://user:pass@host:5432/countersign

# Outgoing mail. Leave unset in development and the confirmation link is shown
# in the browser and the server log instead.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM="Countersign <letters@example.com>"

# Optional. Signs organiser sessions (defaults to ADMIN_PASSWORD).
# SESSION_SECRET=
# Optional. Link to your fork, shown in the footer.
# SOURCE_URL=https://github.com/you/countersign
